.perk-grid {
  margin-top: 0;
  display: flex;
  flex-wrap: wrap;
  row-gap: 16rpx;
  column-gap: 16rpx;
}

.perk-grid__item {
  width: calc((100% - 16rpx) / 2);
  height: 168rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 30rpx;
  font-weight: 500;
  text-align: center;
}

.perk-grid__icon {
  width: 48rpx;
  height: 48rpx;
}

.perk-grid__text {
  width: 100%;
  text-align: center;
  color: #1e293b;
  font-size: 28rpx;
}
