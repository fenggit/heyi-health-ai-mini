<view class="my-header" style="padding-top: {{statusBarHeight}}px;">
  <view class="my-header__inner" style="height: {{navBarHeight}}px;">
    <view wx:if="{{showBack}}" class="my-header__back" bindtap="handleBack">
      <image class="my-header__back-icon" src="/assets/analysis/nav_back.png" mode="aspectFit" />
    </view>
    <view class="my-header__title" bindtap="handleBack">{{title}}</view>
  </view>
  <view
    class="my-header__capsule"
    style="width: {{menuWidth}}px; height: {{menuHeight}}px; right: {{menuRight}}px; top: {{menuTop}}px;"
  ></view>
</view>
