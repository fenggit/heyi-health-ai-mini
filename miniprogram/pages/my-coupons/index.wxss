@import "../profile-sub/common.wxss";

.page-wrap--no-title {
  padding-top: 4rpx;
}

.coupon-tabs {
  display: flex;
  align-items: flex-end;
  padding: 0 20rpx 18rpx;
}

.coupon-tab {
  position: relative;
  margin-right: 64rpx;
  padding-bottom: 8rpx;
}

.coupon-tab:last-child {
  margin-right: 0;
}

.coupon-tab__label {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.coupon-tab--active .coupon-tab__label {
  font-weight: 700;
}

.coupon-tab--active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -20rpx;
  width: 98rpx;
  height: 6rpx;
  border-radius: 6rpx;
  transform: translateX(-50%);
  background: linear-gradient(90deg, #7cee89 0%, #2bc383 100%);
}

.points-list {
  margin-top: 14rpx;
  padding: 20rpx 28rpx;
}

.points-item {
  position: relative;
  margin-top: 16rpx;
  height: 184rpx;
  border-radius: 24rpx;
  background: transparent;
  display: flex;
  align-items: center;
  padding: 0 28rpx 0 0;
  overflow: hidden;
}

.points-item__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.points-item__bg--inactive {
  opacity: 0;
}

.points-item-left,
.points-item-main,
.points-item-btn,
.coupon-item__used-img {
  position: relative;
  z-index: 1;
}

.points-item-left {
  width: 33.3333%;
  margin-left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.points-item-price {
  display: flex;
  align-items: flex-end;
  color: #e17100;
}

.points-item-price-symbol {
  font-size: 32rpx;
  font-weight: 700;
  opacity: 0.55;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.points-item-price-num {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.points-item-score {
  margin-top: 4rpx;
  color: #e17100;
  font-size: 24rpx;
  font-weight: 400;
  text-align: center;
}

.points-item-main {
  flex: 1;
}

.points-item-main__name {
  margin-left: 48rpx;
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 700;
}

.points-item-btn {
  width: 160rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background: #e17100;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
}

.coupon-item__used-img {
  width: 166rpx;
  height: 124rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.coupon-item--inactive {
  background: #94a3b8;
}

.coupon-item--inactive .points-item-price,
.coupon-item--inactive .points-item-score,
.coupon-item--inactive .points-item-main__name {
  color: #cbd5e1;
}

.points-list-empty {
  margin: 24rpx 0 8rpx;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}
