/* ===== 页面容器 ===== */
.fasting-page {
  background: transparent;
  min-height: 100vh;
  position: relative;
}

.fasting-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 750rpx;
  z-index: 0;
  pointer-events: none;
}

/* ===== 内容区 ===== */
.fasting-content {
  position: relative;
  z-index: 1;
  width: 702rpx;
  margin: 0 auto;
  padding-bottom: 60rpx;
}

/* ===== 页面标题行 ===== */
/* 设计稿："轻断食打卡" top=92, fontSize=24, "每日打卡"标签 bg=#CDFF71 */
.fasting-head {
  padding: 16rpx 0 24rpx;
}

.fasting-head__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.fasting-head__title {
  color: #1e293b;
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 设计稿：height=20px→40rpx, cornerRadius=6px→12rpx, bg=#CDFF71 */
.fasting-head__tag {
  height: 40rpx;
  border-radius: 12rpx;
  padding: 0 16rpx;
  background: #cdff71;
  color: #1e293b;
  font-size: 24rpx;
  line-height: 40rpx;
  font-weight: 700;
  margin-top: 12rpx;
  white-space: nowrap;
}

/* ===== 统计卡片（4列） ===== */
/* 设计稿：top=143, height=131, cornerRadius=12, bg=rgba(255,255,255,0.38) */
.fasting-stats-card {
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 32rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.fasting-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.fasting-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 设计稿：数值 fontSize=18px→36rpx, fontFamily=DIN, fontWeight=Bold */
.fasting-stat__value {
  color: #1e293b;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  font-family: "DIN", "Source Han Sans CN", sans-serif;
}

/* 设计稿：标签 fontSize=12px→24rpx, color=#475569 */
.fasting-stat__label {
  color: #475569;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

.fasting-stat__divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(148, 163, 184, 0.3);
}

/* ===== 今日打卡按钮 ===== */
/* 设计稿：height=40px→80rpx, cornerRadius=12px→24rpx, 渐变 #4EFFE2→#CEF94C */
.fasting-checkin-btn {
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #4effe2 0%, #cef94c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fasting-checkin-btn__text {
  color: #1e293b;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

/* ===== 打卡记录 ===== */
.fasting-records {
  margin-top: 32rpx;
}

/* 记录列表整体一个卡片 */
.fasting-record-list {
  margin-top: 16rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  overflow: hidden;
}

/* 设计稿：分割线 color=#f1f5f9, strokeWeight=1 */
.fasting-record-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 0 32rpx;
}

/* 每条记录 */
.fasting-record-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.fasting-record-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
}

/* 名称行：名称 + 时长标签 */
.fasting-record-item__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 设计稿：名称 fontSize=14px→28rpx, fontWeight=700 */
.fasting-record-item__name {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

/* 设计稿：时长标签 width=50px, height=20px, cornerRadius=6px, bg=rgba(0,201,80,0.1), color=#008435 */
.fasting-record-item__duration-tag {
  height: 40rpx;
  border-radius: 12rpx;
  padding: 0 12rpx;
  background: rgba(0, 201, 80, 0.1);
  color: #008435;
  font-size: 24rpx;
  line-height: 40rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 设计稿：时间 fontSize=12px→24rpx, color=#94a3b8 */
.fasting-record-item__time {
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

/* 设计稿：体重/感受 fontSize=12px→24rpx, color=#1e293b */
.fasting-record-item__detail {
  color: #1e293b;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

/* 设计稿：备注 fontSize=12px→24rpx, color=#94a3b8 */
.fasting-record-item__note {
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

/* checkbox 区域 */
.fasting-record-item__check {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 4rpx;
}
