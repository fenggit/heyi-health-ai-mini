<view class="orders-page design-page page-with-nav">
  <image class="page-bg" src="/assets/bg_img.png" mode="widthFix" />

  <my-header title="{{navTitle}}" bind:back="handleBack" />

  <view class="page-top-gap" style="height: {{topInset}}px;"></view>

  <view class="page-wrap page-wrap--no-title">
    <view class="orders-tabs">
      <block wx:for="{{tabs}}" wx:key="key">
        <view class="orders-tab {{activeTab === item.key ? 'orders-tab--active' : ''}}" data-tab="{{item.key}}" bindtap="selectTab">
          <text class="orders-tab__label">{{item.label}}</text>
        </view>
      </block>
    </view>

    <block wx:for="{{filteredOrders}}" wx:key="id" wx:for-item="order">
      <view class="glass-card order-card" data-order-id="{{order.orderId}}" bindtap="viewDetail">
        <view class="order-card__head">
          <view class="order-id">
            <text class="order-id__label">订单号：</text>
            <text class="order-id__value">{{order.id}}</text>
          </view>
          <view class="order-status {{order.statusClass}}">{{order.statusText}}</view>
        </view>

        <view class="order-thumb-row">
          <block wx:for="{{order.items}}" wx:key="image" wx:for-item="product">
            <view class="order-thumb-item">
              <image class="order-thumb-item__image" src="{{product.image}}" mode="aspectFill" />
              <view class="order-thumb-item__count">x{{product.count}}</view>
            </view>
          </block>
          <view class="order-thumb-total">
            <text>共计：</text>
            <text class="order-thumb-total__num">{{order.totalCount}}</text>
            <text>件</text>
          </view>
        </view>

        <view class="order-info-row">
          <view class="order-time">
            <text class="order-time__label">下单时间：</text>
            <text class="order-time__value">{{order.createTime}}</text>
          </view>
          <view class="order-total">
            <text class="order-total__label">合计：</text>
            <text class="order-total__currency">¥</text>
            <text class="order-total__price">{{order.totalPrice}}</text>
          </view>
        </view>

        <view class="order-actions" hidden="{{order.statusText !== '待付款'}}">
          <view class="order-btn order-btn--line" data-id="{{order.id}}" bindtap="viewDetail" hidden="{{true}}">订单详情</view>
          <view class="order-btn order-btn--line" data-id="{{order.id}}" data-order-id="{{order.orderId}}" catchtap="cancelOrder">取消</view>
          <view class="order-btn order-btn--line" data-id="{{order.id}}" data-order-id="{{order.orderId}}" catchtap="payOrder">支付</view>
        </view>
      </view>
    </block>
  </view>
</view>
