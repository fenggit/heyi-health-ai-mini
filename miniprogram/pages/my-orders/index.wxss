@import "../profile-sub/common.wxss";

.page-wrap--no-title {
  padding-top: 4rpx;
}

.orders-tabs {
  display: flex;
  align-items: flex-end;
  padding: 0 20rpx 18rpx;
  border-bottom: 2rpx solid rgba(203, 213, 225, 0.7);
}

.orders-tab {
  position: relative;
  margin-right: 60rpx;
  padding-bottom: 8rpx;
}

.orders-tab:last-child {
  margin-right: 0;
}

.orders-tab__label {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.orders-tab--active .orders-tab__label {
  font-weight: 700;
}

.orders-tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -20rpx;
  width: 88rpx;
  height: 6rpx;
  border-radius: 6rpx;
  transform: translateX(-50%);
  background: linear-gradient(90deg, #7cee89 0%, #2bc383 100%);
}

.order-card {
  margin-top: 16rpx;
  padding: 32rpx;
}

.order-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-id {
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.order-id__label {
  font-weight: 700;
}

.order-id__value {
  font-weight: 600;
}

.order-status {
  min-width: 104rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  font-weight: 700;
}

.order-status--pending {
  color: #1e293b;
  background: #f4d900;
}

.order-status--shipping {
  color: #ffffff;
  background: #101010;
}

.order-status--completed {
  color: #ffffff;
  background: #00c950;
}

.order-thumb-row {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
}

.order-thumb-item {
  position: relative;
  margin-right: 12rpx;
}

.order-thumb-item__image {
  width: 156rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: block;
}

.order-thumb-item__image--empty {
  background: #f1f5f9;
}

.order-thumb-item__count {
  position: absolute;
  right: -4rpx;
  bottom: -8rpx;
  min-width: 40rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  border: 2rpx solid #ffffff;
  background: #fb2c36;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 700;
}

.order-thumb-total {
  margin-top: 44rpx;
  margin-left: auto;
  color: #475569;
  font-size: 24rpx;
  line-height: 36rpx;
}

.order-thumb-total__num {
  margin: 0 6rpx;
  font-weight: 700;
}

.order-info-row {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 2rpx dashed rgba(203, 213, 225, 0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  color: #64748b;
  font-size: 28rpx;
  line-height: 40rpx;
}

.order-time__label {
  color: #64748b;
}

.order-time__value {
  color: #64748b;
}

.order-total {
  display: flex;
  align-items: flex-end;
  color: #1e293b;
  font-size: 24rpx;
  line-height: 36rpx;
}

.order-total__label {
  margin-right: 4rpx;
  color: #1e293b;
  line-height: 36rpx;
}

.order-total__currency {
  color: #fb2c36;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.order-total__price {
  color: #fb2c36;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.order-actions {
  margin-top: 36rpx;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.order-btn {
  width: 176rpx;
  height: 56rpx;
  border-radius: 28rpx;
  padding: 0;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 52rpx;
  text-align: center;
}

.order-btn--line {
  border: 2rpx solid #e2e8f0;
  color: #1e293b;
  background: #ffffff;
}
