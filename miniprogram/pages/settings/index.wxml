<view class="setting-page design-page page-with-nav">
  <image class="page-bg" src="/assets/bg_img.png" mode="widthFix" />

  <my-header title="{{navTitle}}" bind:back="handleBack" />

  <view class="page-top-gap" style="height: {{topInset}}px;"></view>

  <view class="page-wrap page-wrap--no-title">
    <view class="glass-card setting-profile-card">
      <view class="setting-section-head">
        <title-view text="个人资料" />
      </view>

      <view class="setting-profile-row setting-profile-row--avatar" bindtap="editAvatar">
        <view class="setting-profile-label">头像</view>
        <view class="setting-profile-value setting-profile-value--avatar">
          <view class="setting-avatar">
            <image wx:if="{{avatarUrl}}" class="setting-avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{avatarText}}</text>
          </view>
          <text class="setting-arrow">></text>
        </view>
      </view>

      <view class="setting-divider"></view>

      <view class="setting-profile-row" bindtap="editNickname">
        <view class="setting-profile-label">昵称</view>
        <view class="setting-profile-value">
          <text class="setting-profile-text">{{nickname}}</text>
          <text class="setting-arrow">></text>
        </view>
      </view>

      <view class="setting-divider"></view>

      <view class="setting-profile-row" bindtap="openAddressPage">
        <view class="setting-profile-label">收货地址</view>
        <view class="setting-profile-value">
          <text class="setting-arrow">></text>
        </view>
      </view>
    </view>

    <view class="glass-card setting-main-card">
      <view class="setting-section-head">
        <title-view text="偏好设置" />
      </view>

      <view class="setting-switch-row">
        <view class="setting-switch-copy">
          <view class="setting-switch-title">消息通知</view>
          <view class="setting-switch-desc">接收健康提醒和活动通知</view>
        </view>
        <switch class="setting-switch" color="#00c950" checked="{{notifyEnabled}}" bindchange="onNotifyChange" />
      </view>

      <view class="setting-divider"></view>

      <view class="setting-switch-row">
        <view class="setting-switch-copy">
          <view class="setting-switch-title">深色模式</view>
          <view class="setting-switch-desc">接收健康提醒和活动通知</view>
        </view>
        <switch class="setting-switch" color="#00c950" checked="{{darkModeEnabled}}" bindchange="onDarkModeChange" />
      </view>

      <view class="setting-tip">提示：开启消息通知后，您将及时收到体质调理建议、食养方案更新和专属优惠活动信息。</view>
    </view>

    <view class="setting-bottom">
      <view class="setting-logout" bindtap="logout">退出登录</view>
    </view>
  </view>
</view>
