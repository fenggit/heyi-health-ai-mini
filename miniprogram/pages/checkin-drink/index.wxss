/* ===== 页面容器 ===== */
.drink-page {
  background: transparent;
  min-height: 100vh;
  position: relative;
}

.drink-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 750rpx;
  z-index: 0;
  pointer-events: none;
}

/* ===== 内容区（headerHeight 占位后的内容） ===== */
.drink-content {
  position: relative;
  z-index: 1;
  width: 702rpx;
  margin: 0 auto;
  padding-bottom: 60rpx;
}

/* ===== 页面标题行 ===== */
.drink-head {
  padding: 16rpx 0 24rpx;
}

.drink-head__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

/* 设计稿：fontSize=24px→48rpx, fontWeight=700 */
.drink-head__title {
  color: #1e293b;
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 设计稿：height=20px→40rpx, cornerRadius=6px→12rpx, bg=#CDFF71, fontSize=12px→24rpx */
.drink-head__tag {
  height: 40rpx;
  border-radius: 12rpx;
  padding: 0 16rpx;
  background: #cdff71;
  color: #1e293b;
  font-size: 24rpx;
  line-height: 40rpx;
  font-weight: 700;
  margin-top: 12rpx;
  white-space: nowrap;
}

/* ===== 统计卡片 ===== */
/* 设计稿：top=143, height=131, cornerRadius=12, bg=rgba(255,255,255,0.38) */
.drink-stats-card {
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 32rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.drink-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.drink-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 设计稿：数值 fontSize=18px→36rpx, fontFamily=DIN, fontWeight=Bold */
.drink-stat__value {
  color: #1e293b;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  font-family: "DIN", "Source Han Sans CN", sans-serif;
}

/* 设计稿：标签 fontSize=12px→24rpx, fontWeight=400, color=#475569 */
.drink-stat__label {
  color: #475569;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

.drink-stat__divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(148, 163, 184, 0.3);
}

/* ===== 今日打卡按钮 ===== */
/* 设计稿：height=40px→80rpx, cornerRadius=12px→24rpx, 渐变 #4EFFE2→#CEF94C */
.drink-checkin-btn {
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #4effe2 0%, #cef94c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 设计稿：fontSize=16px→32rpx, fontWeight=700 */
.drink-checkin-btn__text {
  color: #1e293b;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

/* ===== 打卡记录 ===== */
.drink-records {
  margin-top: 32rpx;
}

.drink-record-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 设计稿：记录卡片 height=106px→212rpx, cornerRadius=12px→24rpx, bg=rgba(255,255,255,0.7) */
.drink-record-item {
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  overflow: hidden;
  height: 212rpx;
  box-sizing: border-box;
}

/* 左侧空白图片占位 */
.drink-record-item__img-placeholder {
  width: 180rpx;
  height: 212rpx;
  flex-shrink: 0;
  border-radius: 24rpx 0 0 24rpx;
  background: rgba(244, 247, 250, 0.8);
}

/* 右侧文字区 */
.drink-record-item__body {
  flex: 1;
  padding: 24rpx 16rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  overflow: hidden;
}

/* 设计稿：名称 fontSize=14px→28rpx, fontWeight=700 */
.drink-record-item__name {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

/* 设计稿：时间 fontSize=12px→24rpx, color=#94a3b8 */
.drink-record-item__time {
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

/* 设计稿：备注 fontSize=12px→24rpx, color=#1e293b */
.drink-record-item__note {
  color: #1e293b;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 400;
}

/* 右侧 checkbox 区域 */
.drink-record-item__check {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
