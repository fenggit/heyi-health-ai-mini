.new-page {
  background: transparent;
  min-height: 100vh;
  position: relative;
}

.new-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 750rpx;
  z-index: 0;
  pointer-events: none;
}

.new-content {
  position: relative;
  z-index: 1;
  height: calc(100vh - var(--header-height, 64px));
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

/* ===== section 通用 ===== */
.new-section {
  width: 702rpx;
  margin: 16rpx auto 0;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 32rpx;
  box-sizing: border-box;
}

/* ===== 打卡日期 ===== */
.new-section--date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.new-date__label {
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
}

.new-date__value {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

/* ===== section 标题 ===== */
.new-section__title-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.new-section__title {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 24rpx;
}

.new-section__title-row .new-section__title {
  margin-bottom: 0;
}

.new-section__required {
  color: #fb2c36;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  margin-left: 6rpx;
}

/* ===== 断食类型网格 ===== */
.new-type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.new-type-item {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.new-type-item--active {
  border-color: #2bc383;
  background: rgba(43, 195, 131, 0.08);
}

.new-type-item__text {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 500;
}

.new-type-item--active .new-type-item__text {
  color: #2bc383;
  font-weight: 700;
}

/* ===== 断食时间 ===== */
.new-time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* picker 组件本身不占额外空间，让内部 view 撑开 */
picker {
  flex: 1;
  display: block;
}

.new-time-picker {
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.new-time-picker__label {
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1;
}

.new-time-picker__value {
  color: #1e293b;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  font-family: "DIN", "Source Han Sans CN", sans-serif;
}

.new-time-arrow {
  color: #94a3b8;
  font-size: 32rpx;
  flex-shrink: 0;
}

.new-duration {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(43, 195, 131, 0.08);
}

.new-duration__text {
  color: #2bc383;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

/* ===== 体重/体脂输入 ===== */
.new-input-row {
  display: flex;
  align-items: center;
  height: 80rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.new-number-input {
  flex: 1;
  height: 80rpx;
  color: #1e293b;
  font-size: 32rpx;
  font-weight: 600;
  font-family: "DIN", "Source Han Sans CN", sans-serif;
}

.new-number-input__placeholder {
  color: #cbd5e1;
  font-size: 28rpx;
  font-weight: 400;
}

.new-input-unit {
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 500;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ===== 身体感受标签 ===== */
.new-feeling-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.new-feeling-item {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.new-feeling-item--active {
  border-color: #2bc383;
  background: rgba(43, 195, 131, 0.08);
}

.new-feeling-item__text {
  color: #475569;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 500;
}

.new-feeling-item--active .new-feeling-item__text {
  color: #2bc383;
  font-weight: 700;
}

/* ===== 打卡笔记 ===== */
.new-note-input {
  width: 100%;
  min-height: 160rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 400;
}

.new-note-input__placeholder {
  color: #94a3b8;
  font-size: 28rpx;
}

.new-note-count {
  display: block;
  text-align: right;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-top: 8rpx;
}

/* ===== 底部按钮 ===== */
.new-footer {
  width: 702rpx;
  margin: 32rpx auto 0;
  padding-bottom: 20rpx;
  display: flex;
  gap: 24rpx;
}

.new-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.new-btn--share {
  background: linear-gradient(135deg, #4effe2 0%, #cef94c 100%);
}

.new-btn--submit {
  background: linear-gradient(135deg, #7cee89 0%, #2bc383 100%);
}

.new-btn__text {
  color: #1e293b;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
}
