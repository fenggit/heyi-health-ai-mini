@import "../profile-sub/common.wxss";

.page-wrap--no-title {
  padding-top: 4rpx;
}

.favorite-card {
  margin-top: 16rpx;
  min-height: 368rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
}

.favorite-cover {
  width: 156rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #f1f5f9;
}

.favorite-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.favorite-name {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.favorite-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.favorite-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 40rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: rgba(0, 201, 80, 0.14);
  color: #008435;
  font-size: 24rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.favorite-desc {
  margin-top: 14rpx;
  color: #1e293b;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 500;
}

.favorite-divider {
  width: 100%;
  margin-top: 28rpx;
  border-top: 2rpx dashed #cbd5e1;
}

.favorite-foot {
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.favorite-time {
  color: #64748b;
  font-size: 28rpx;
  line-height: 40rpx;
}

.favorite-time__label,
.favorite-time__value {
  color: #64748b;
}

.favorite-cancel {
  width: 176rpx;
  height: 56rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 52rpx;
  text-align: center;
}

.favorite-empty {
  margin-top: 24rpx;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
  line-height: 38rpx;
}

.favorite-load-more {
  margin: 24rpx 0 12rpx;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
  line-height: 36rpx;
}
