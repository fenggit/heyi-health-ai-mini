@import "../profile-sub/common.wxss";

/* ── 标题行 ── */
.points-page .page-title {
  font-size: 48rpx;
}

.points-page .page-subtitle {
  margin-top: 24rpx;
  margin-bottom: 32rpx;
}

.points-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 积分获取规则按钮：w:108px h:32px radius:12px border:#008435 opacity:0.2 fontSize:14px */
.points-rule-btn {
  width: 216rpx;
  height: 64rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0, 132, 53, 0.2);
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
}

/* ── 积分概览卡片（复用 profile-member 结构） ── */
.points-page .card-panel.points-member {
  position: relative;
  margin-top: 14rpx;
  padding: 0;
  border: none !important;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  overflow: hidden;
}

.points-member__bg-module {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  display: block;
  pointer-events: none;
}

.points-member__vip-section {
  position: relative;
  z-index: 2;
  height: 140rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: transparent;
}

.points-member__head {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-member__title {
  display: inline-flex;
  align-items: center;
  color: #131313;
  font-size: 30rpx;
  font-weight: 700;
}

.points-member__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.points-member__num {
  color: #131313;
  font-size: 30rpx;
  font-weight: 700;
}

/* 会员等级 badge */
.points-summary-member {
  height: 56rpx;
  border-radius: 18rpx;
  padding: 0 20rpx;
  background: #131313;
  color: #cdff71;
  font-size: 24rpx;
  line-height: 56rpx;
  font-weight: 500;
}

.points-member__month-row {
  position: relative;
  z-index: 2;
  height: 104rpx;
  margin: 0 -2rpx -2rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  border: 2rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.points-member__stat-val {
  color: #1e293b;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

/* ── 可兑换礼品 / 流水 ── */
.points-list {
  margin-top: 14rpx;
  padding: 20rpx 28rpx;
}

/* 标题 */
.points-list-title {
  margin-bottom: 8rpx;
}

/* 兑换 item：h:92px radius:12px bg:#E17100 5% */
.points-item {
  position: relative;
  margin-top: 16rpx;
  height: 184rpx;
  border-radius: 24rpx;
  background: transparent;
  display: flex;
  align-items: center;
  padding: 0 28rpx 0 0;
  overflow: hidden;
}

.points-item__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.points-item-left,
.points-item-main,
.points-item-btn {
  position: relative;
  z-index: 1;
}

/* 左侧金额区 */
.points-item-left {
  width: 33.3333%;
  margin-left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* ¥ + 数字组合：¥ fontSize:16px opacity:0.55, 数字 fontSize:32px bold */
.points-item-price {
  display: flex;
  align-items: flex-end;
  color: #e17100;
}

.points-item-price-symbol {
  font-size: 32rpx;
  font-weight: 700;
  opacity: 0.55;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.points-item-price-num {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

/* 积分子标题：fontSize:12px color:#E17100 */
.points-item-score {
  margin-top: 4rpx;
  color: #e17100;
  font-size: 24rpx;
  font-weight: 400;
  text-align: center;
}

.points-item-main {
  flex: 1;
}

/* 商品名：fontSize:14px bold color:#1E293B */
.points-item-main__name {
  margin-left: 48rpx;
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 700;
}

/* 库存：fontSize:12px color:#94A3B8 */
.points-item-main__stock {
  margin-left: 48rpx;
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

/* 兑换按钮：w:80px h:32px radius:12px bg:#E17100 fontSize:14px medium */
.points-item-btn {
  width: 160rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background: #e17100;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
}

.points-item-btn--disabled {
  background: #cbd5e1;
  color: #64748b;
}

.points-list-empty {
  margin: 24rpx 0 8rpx;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}

.points-rules-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.42);
  z-index: 90;
}

.points-rules-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  min-height: 500rpx;
  border-radius: 24rpx;
  background: #ffffff;
  z-index: 91;
  box-sizing: border-box;
  padding: 36rpx 32rpx 28rpx;
}

.points-rules-popup__title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.points-rules-popup__loading,
.points-rules-popup__empty {
  margin-top: 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.points-rules-popup__list {
  margin-top: 28rpx;
}

.points-rules-popup__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.points-rules-popup__item:last-child {
  margin-bottom: 0;
}

.points-rules-popup__name {
  max-width: 360rpx;
  color: #475569;
  font-size: 28rpx;
  line-height: 40rpx;
}

.points-rules-popup__score {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #1db86d;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.points-rules-popup__close {
  margin: 28rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f1f5f9;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
}
