<view class="points-page design-page page-with-nav">
  <image class="page-bg" src="/assets/bg_img.png" mode="widthFix" />

  <my-header title="{{navTitle}}" bind:back="handleBack" />

  <view class="page-top-gap" style="height: {{topInset}}px;"></view>

  <view class="page-wrap">
    <!-- 标题行 -->
    <view class="points-head">
      <view>
        <view class="page-title">{{pageTitle}}</view>
        <view class="page-subtitle">{{pageSubTitle}}</view>
      </view>
      <view class="points-rule-btn" bindtap="openRules">积分获取规则</view>
    </view>

    <!-- 积分概览卡片（参考 profile-member） -->
    <view class="card-panel points-member">
      <image class="points-member__bg-module" src="/assets/bg_module.png" mode="scaleToFill" />
      <view class="points-member__vip-section">
        <view class="points-member__head">
          <view class="points-member__title">
            <image class="points-member__icon" src="/assets/profile/vip.png" mode="aspectFit" />
            我的积分：<text class="points-member__num">{{availablePoints}}</text>
          </view>
          <view class="points-summary-member">{{memberLevel}}</view>
        </view>
      </view>
      <view class="points-member__month-row">
        <title-view text="本月获得" />
        <view class="points-member__stat-val">+{{monthEarnedPoints || 0}}</view>
      </view>
    </view>

    <!-- 可兑换礼品 -->
    <view class="glass-card points-list">
      <view class="points-list-title">
        <title-view text="可兑换礼品" />
      </view>
      <block wx:if="{{rewardItems.length > 0}}">
        <block wx:for="{{rewardItems}}" wx:key="id" wx:for-item="reward">
          <view class="points-item">
            <image class="points-item__bg" src="/assets/bg_coupon.png" mode="scaleToFill" />
            <!-- 左侧金额 -->
            <view class="points-item-left">
              <view class="points-item-price">
                <text class="points-item-price-symbol">￥</text>
                <text class="points-item-price-num">{{reward.leftTitle}}</text>
              </view>
              <view class="points-item-score">{{reward.leftSub}}</view>
            </view>
            <!-- 中间信息 -->
            <view class="points-item-main">
              <view class="points-item-main__name">{{reward.name}}</view>
              <view class="points-item-main__stock">库存 {{reward.stock}}</view>
            </view>
            <!-- 兑换按钮 -->
            <view
              class="points-item-btn {{(!reward.canRedeem || redeemingId) ? 'points-item-btn--disabled' : ''}}"
              data-id="{{reward.id}}"
              bindtap="redeem"
            >
              {{redeemingId === reward.id ? '兑换中...' : reward.buttonText}}
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="points-list-empty">暂无可兑换礼品</view>
    </view>

  </view>

  <view
    wx:if="{{showRulesPopup}}"
    class="points-rules-mask"
    catchtap="closeRulesPopup"
  ></view>
  <view
    wx:if="{{showRulesPopup}}"
    class="points-rules-popup"
    catchtap="stopRulesPopupTap"
  >
    <view class="points-rules-popup__title">积分获取规则</view>
    <view wx:if="{{rulesLoading}}" class="points-rules-popup__loading">加载中...</view>
    <view wx:elif="{{rulesItems.length > 0}}" class="points-rules-popup__list">
      <block wx:for="{{rulesItems}}" wx:key="id" wx:for-item="rule">
        <view class="points-rules-popup__item">
          <text class="points-rules-popup__name">{{rule.title}}</text>
          <text class="points-rules-popup__score">{{rule.pointsText}}</text>
        </view>
      </block>
    </view>
    <view wx:elif="{{rulesError === 'load_failed'}}" class="points-rules-popup__empty">积分规则加载失败</view>
    <view wx:else class="points-rules-popup__empty">暂无积分规则</view>
    <view class="points-rules-popup__close" bindtap="closeRulesPopup">我知道了</view>
  </view>
</view>
