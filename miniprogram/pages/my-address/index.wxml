<view class="address-page design-page page-with-nav">
  <image class="page-bg" src="/assets/bg_img.png" mode="widthFix" />

  <my-header bind:back="handleBack" />

  <view class="page-top-gap" style="height: {{topInset}}px;"></view>

  <view class="page-wrap page-wrap--no-title">
    <view class="address-head">
      <text class="address-head__label">我的地址</text>
      <view class="address-head__add" bindtap="openAddressForm">
        <text class="address-head__add-icon">+</text>
        <text class="address-head__add-text">新增</text>
      </view>
    </view>

    <view class="address-list">
      <block wx:for="{{addressList}}" wx:key="id">
        <view class="address-item {{selectedAddressId === item.id ? 'address-item--active' : ''}}" data-id="{{item.id}}" bindtap="selectAddress">
          <view class="address-item__top">
            <text class="address-item__name">{{item.name}}</text>
            <text class="address-item__phone">{{item.phone}}</text>
            <text class="address-item__edit-icon" data-id="{{item.id}}" catchtap="openEditAddressForm">✎</text>
          </view>
          <text class="address-item__address">{{item.address}}</text>
          <view class="address-item__divider"></view>
          <view class="address-item__bottom">
            <view class="address-item__default" data-id="{{item.id}}" catchtap="toggleDefaultAddress">
              <view class="address-check {{item.isDefault ? 'address-check--active' : ''}}">
                <text wx:if="{{item.isDefault}}" class="address-check__mark">✓</text>
              </view>
              <text class="address-item__default-text {{item.isDefault ? 'address-item__default-text--active' : ''}}">默认地址</text>
            </view>
            <view class="address-item__actions">
              <view class="address-item__delete" data-id="{{item.id}}" catchtap="deleteAddress">
                <text class="address-item__delete-text">删除</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{showAddressForm}}" class="address-mask" catchtap="closeAddressForm"></view>
  <view wx:if="{{showAddressForm}}" class="address-sheet" catchtap="stopAddressTap">
    <view class="address-sheet__title">{{editAddressId ? '编辑收货地址' : '新增收货地址'}}</view>

    <view class="address-form">
      <view class="address-form__row">
        <text class="address-form__label">收货地址：</text>
        <input
          class="address-form__input"
          placeholder="请输入详细地址"
          placeholder-class="address-form__placeholder"
          data-field="address"
          bindinput="onNewAddressInput"
          value="{{newAddress.address}}"
        />
      </view>

      <view class="address-form__row">
        <text class="address-form__label">收货人：</text>
        <input
          class="address-form__input"
          placeholder="请输入姓名"
          placeholder-class="address-form__placeholder"
          data-field="name"
          bindinput="onNewAddressInput"
          value="{{newAddress.name}}"
        />
        <view class="address-form__gender">
          <view class="address-form__gender-item" data-gender="female" bindtap="onGenderTap">
            <view class="address-form__radio {{newAddress.gender === 'female' ? 'address-form__radio--active' : ''}}">
              <text wx:if="{{newAddress.gender === 'female'}}" class="address-form__radio-mark">✓</text>
            </view>
            <text class="address-form__gender-text {{newAddress.gender === 'female' ? '' : 'address-form__gender-text--inactive'}}">女士</text>
          </view>
          <view class="address-form__gender-item" data-gender="male" bindtap="onGenderTap">
            <view class="address-form__radio {{newAddress.gender === 'male' ? 'address-form__radio--active' : ''}}">
              <text wx:if="{{newAddress.gender === 'male'}}" class="address-form__radio-mark">✓</text>
            </view>
            <text class="address-form__gender-text {{newAddress.gender !== 'male' ? 'address-form__gender-text--inactive' : ''}}">先生</text>
          </view>
        </view>
      </view>

      <view class="address-form__row">
        <text class="address-form__label">手机号：</text>
        <input
          class="address-form__input"
          placeholder="请输入手机号"
          placeholder-class="address-form__placeholder"
          type="number"
          data-field="phone"
          bindinput="onNewAddressInput"
          value="{{newAddress.phone}}"
        />
      </view>
    </view>

    <view class="address-sheet__actions">
      <view class="address-sheet__btn address-sheet__btn--cancel" bindtap="closeAddressForm">取消</view>
      <view class="address-sheet__btn address-sheet__btn--confirm" bindtap="saveNewAddress">保存</view>
    </view>
    <view class="address-sheet__safe"></view>
  </view>
</view>
