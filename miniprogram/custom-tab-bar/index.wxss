.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #ffffff;
  box-sizing: border-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-panel {
  width: 100%;
  height: 98rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.tabbar-track {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-item__text-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
}

.tabbar-item__ball {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(calc(-50% - 12rpx));
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  opacity: 0.4;
  background: linear-gradient(180deg, #7cee89 0%, #2bc383 100%);
}

.tabbar-item__icon {
  width: 88rpx;
  height: 88rpx;
  display: block;
}

.tabbar-item__text {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 400;
  color: #94a3b8;
  font-family: "Source Han Sans CN", "PingFang SC", sans-serif;
}

.tabbar-item--active .tabbar-item__text {
  font-weight: 700;
  color: #1e293b;
}
