<view class="tabbar-wrap">
  <view class="tabbar-panel">
    <view class="tabbar-track">
      <block wx:for="{{tabs}}" wx:key="path" wx:for-item="tab" wx:for-index="index">
        <block wx:if="{{index < 2}}">
          <view
            class="tabbar-item {{selected === index ? 'tabbar-item--active' : ''}}"
            data-path="{{tab.path}}"
            data-index="{{index}}"
            bindtap="switchTab"
          >
            <view class="tabbar-item__text-wrap">
              <view class="tabbar-item__ball" wx:if="{{selected === index}}"></view>
              <text class="tabbar-item__text">{{tab.text}}</text>
            </view>
          </view>
        </block>
      </block>

      <view class="tabbar-item tabbar-item--center" bindtap="openAiChat">
        <view class="tabbar-item__text-wrap">
          <text class="tabbar-item__text">AI食养</text>
        </view>
      </view>

      <block wx:for="{{tabs}}" wx:key="path" wx:for-item="tab" wx:for-index="index">
        <block wx:if="{{index >= 2 && index <= 3}}">
          <view
            class="tabbar-item {{selected === index ? 'tabbar-item--active' : ''}}"
            data-path="{{tab.path}}"
            data-index="{{index}}"
            bindtap="switchTab"
          >
            <view class="tabbar-item__text-wrap">
              <view class="tabbar-item__ball" wx:if="{{selected === index}}"></view>
              <text class="tabbar-item__text">{{tab.text}}</text>
            </view>
          </view>
        </block>
      </block>
    </view>
  </view>
</view>
